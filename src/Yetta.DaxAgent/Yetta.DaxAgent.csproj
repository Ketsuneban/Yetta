<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yetta.DAX</AssemblyName>
    <RootNamespace>Yetta.DaxAgent</RootNamespace>
    <Company>Tallow</Company>
    <Authors>Tallow</Authors>
    <Version>0.7.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Yetta.Core/Yetta.Core.csproj" />
    <EmbeddedResource Include="Assets\*.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../local.json" Link="local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
