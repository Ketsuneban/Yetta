<Window x:Class="Yetta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Yetta — Windows, on your terms."
        Width="1180" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}" FontSize="14">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Default WPF ScrollViewer template contributes a 1px rectangular
         outline and keyboard focus rectangle, even when its parent Border
         has BorderThickness=0. Remove those chrome strokes globally. -->
    <Style TargetType="{x:Type ScrollViewer}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="{x:Type TextBox}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style TargetType="{x:Type PasswordBox}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style TargetType="{x:Type RichTextBox}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="{x:Type ListBox}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="{x:Type ListView}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="{x:Type DataGrid}"><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HorizontalGridLinesBrush" Value="Transparent"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/></Style>
    <Style TargetType="{x:Type Border}"><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
    <Style x:Key="SideButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource HoverBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="17,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value=".83"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value=".40"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Narrow, rounded theme-aware scrolling for content; navigation has no visible scrollbar. -->
    <Style x:Key="ModernThumb" TargetType="{x:Type Thumb}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbSurface" Background="{DynamicResource TextSecondary}"
                    CornerRadius="4" Margin="1,2" Opacity="0.65"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernThumb}" MinHeight="28"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
    <Style x:Key="AccessComboItem" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Margin="4,2" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccessCombo" TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="47"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource AccessComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="DropToggle"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="ComboSurface" Background="{DynamicResource SidebarBackground}"
                            BorderBrush="Transparent" BorderThickness="0"
                            CornerRadius="12" Padding="14,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                          IsHitTestVisible="False" TextElement.Foreground="{DynamicResource TextPrimary}"/>
                        <Path Grid.Column="1" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.7"
                              Data="M 2,5 L 8,11 L 14,5" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,5,0,10" Padding="5" MaxHeight="300"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="Transparent" BorderThickness="0"
                        CornerRadius="13">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.3"/>
                  </Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="CaptionDragArea" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
          <Image Source="/Assets/yetta-logo.png" Width="23" Height="23" Margin="0,0,9,0"/>
          <TextBlock Text="{DynamicResource Local.ui.main.0012}" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0001}" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButton}" Click="OnWindowMinimize"
                  ToolTip="{DynamicResource Local.ui.xaml.0002}" Content="&#xE921;"/>
          <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButton}" Click="OnWindowMaximize"
                  ToolTip="{DynamicResource Local.ui.main.0011}" Content="&#xE922;"/>
          <Button x:Name="CaptionClose" Style="{StaticResource CaptionButton}" Click="OnWindowClose"
                  ToolTip="{DynamicResource Local.ui.warning.0008}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
      <DockPanel Margin="18,23,17,22" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="14" Background="Transparent" Margin="5,7"/>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0003}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold" Margin="8,0,0,9"/>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0004}"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                     FontSize="12" Margin="8,0,0,10"/>
          <TextBlock x:Name="SidebarVersion" FontSize="10"
                     Foreground="{DynamicResource TextSecondary}" Margin="8,0"/>
        </StackPanel>
        <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,0,0,46">
            <Border Width="44" Height="44" CornerRadius="13"
                    Background="{DynamicResource SelectedBrush}">
              <Image Source="/Assets/yetta-logo.png" Width="40" Height="40" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="13,3,0,0">
              <TextBlock Text="{DynamicResource Local.ui.xaml.0006}" Foreground="{DynamicResource TextPrimary}"
                         FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource Local.ui.xaml.0007}" Foreground="{DynamicResource TextSecondary}" FontSize="9"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0008}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,0,0,14"/>
          <Button x:Name="NavOverview" Content="{DynamicResource Local.ui.xaml.0009}" Tag="overview" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavInfo" Content="{DynamicResource Local.ui.xaml.0010}" Tag="info" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavConsole" Content="{DynamicResource Local.ui.xaml.0011}" Tag="console" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0012}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,27,0,12"/>
          <Button x:Name="NavGuard" Content="{DynamicResource Local.ui.xaml.0013}" Tag="guard" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavLogs" Content="{DynamicResource Local.ui.xaml.0014}" Tag="logs" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavActivity" Content="{DynamicResource Local.ui.xaml.0015}" Tag="activity" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavRecovery" Content="{DynamicResource Local.ui.xaml.0016}" Tag="recovery" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <TextBlock Text="{DynamicResource Local.ui.xaml.0017}" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,27,0,12"/>
          <Button x:Name="NavSettings" Content="{DynamicResource Local.ui.xaml.0018}" Tag="settings" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavSources" Content="{DynamicResource Local.ui.xaml.0019}" Tag="sources" Style="{StaticResource SideButton}" Click="OnNavigate"/>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="82"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0">
        <Grid Margin="34,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{DynamicResource Local.ui.main.0001}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="PageSubtitle" Text="{DynamicResource Local.ui.xaml.0020}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Center"
                  Background="{DynamicResource SelectedBrush}" CornerRadius="10" Padding="12,8">
            <TextBlock x:Name="ThemeIndicator" Text="{DynamicResource Local.ui.xaml.0021}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" Focusable="False" FocusVisualStyle="{x:Null}" BorderThickness="0" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="34,30,34,30">
        <ScrollViewer.Resources>
          <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel x:Name="ContentPanel"/>
      </ScrollViewer>
      <Border Grid.Row="2">
        <Grid Margin="34,0">
          <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}"><Run Text="{DynamicResource Local.ui.xaml.0027}"/><Hyperlink NavigateUri="https://icons8.ru/" RequestNavigate="OnFooterLink"><Run Text="{DynamicResource Local.ui.xaml.0028}"/></Hyperlink></TextBlock>
          <TextBlock x:Name="FooterVersion" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
        </Grid>
      </Border>
      <StackPanel x:Name="ToastHost" Grid.RowSpan="3" Panel.ZIndex="20" Width="324" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,12,22,56"/>
    </Grid>
    </Grid>
  </Grid>
</Window>
