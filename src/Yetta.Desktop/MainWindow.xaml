<Window x:Class="Yetta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Yetta — Windows, on your terms."
        Width="1180" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="./Assets/#Inter" FontSize="14">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SideButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource HoverBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="17,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value=".83"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value=".40"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Narrow, rounded theme-aware scrolling for content; navigation has no visible scrollbar. -->
    <Style x:Key="ModernThumb" TargetType="{x:Type Thumb}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbSurface" Background="{DynamicResource TextSecondary}"
                    CornerRadius="4" Margin="1,2" Opacity="0.65"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernThumb}" MinHeight="28"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccessComboItem" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Margin="4,2" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccessCombo" TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="47"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource AccessComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="DropToggle"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="ComboSurface" Background="{DynamicResource SidebarBackground}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                          IsHitTestVisible="False" TextElement.Foreground="{DynamicResource TextPrimary}"/>
                        <Path Grid.Column="1" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                              Data="M 2,5 L 8,11 L 14,5" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,5,0,10" Padding="5" MaxHeight="300"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                        CornerRadius="13">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.3"/>
                  </Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource HoverBackground}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
          <Image Source="/Assets/yetta-logo.png" Width="23" Height="23" Margin="0,0,9,0"/>
          <TextBlock Text="Yetta" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="  —  Windows, on your terms." FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButton}" Click="OnWindowMinimize"
                  ToolTip="Свернуть" Content="─"/>
          <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButton}" Click="OnWindowMaximize"
                  ToolTip="Развернуть" Content="□"/>
          <Button x:Name="CaptionClose" Style="{StaticResource CaptionButton}" Click="OnWindowClose"
                  ToolTip="Закрыть" Content="✕"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,23,17,22" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="5,14"/>
          <TextBlock Text="●  DESKTOP PREVIEW" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold" Margin="8,0,0,9"/>
          <TextBlock Text="DAX и привилегированные службы не установлены."
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                     FontSize="12" Margin="8,0,0,10"/>
          <TextBlock Text="YETTA 0.3.1 · WINDOWS 11" FontSize="10"
                     Foreground="{DynamicResource TextSecondary}" Margin="8,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="5,0,0,46">
            <Border Width="44" Height="44" CornerRadius="13"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
              <Image Source="/Assets/yetta-logo.png" Width="40" Height="40" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="13,3,0,0">
              <TextBlock Text="YETTA" Foreground="{DynamicResource TextPrimary}"
                         FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="Windows, on your terms." Foreground="{DynamicResource TextSecondary}" FontSize="9"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,0,0,14"/>
          <Button x:Name="NavOverview" Content="⌂   Главная" Tag="overview" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavInfo" Content="ⓘ   Информация" Tag="info" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavConsole" Content="⌘   Консоль" Tag="console" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <TextBlock Text="БЕЗОПАСНОСТЬ" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,27,0,12"/>
          <Button x:Name="NavGuard" Content="⛨   DAX Guard" Tag="guard" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavLogs" Content="▤   DAX Logs" Tag="logs" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavActivity" Content="◉   Центр активности" Tag="activity" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavRecovery" Content="↶   DAX Recovery" Tag="recovery" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <TextBlock Text="ПРИЛОЖЕНИЕ" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="13,27,0,12"/>
          <Button x:Name="NavSettings" Content="⚙   Настройки" Tag="settings" Style="{StaticResource SideButton}" Click="OnNavigate"/>
          <Button x:Name="NavSources" Content="↗   Источники" Tag="sources" Style="{StaticResource SideButton}" Click="OnNavigate"/>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="82"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="34,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Главная" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="PageSubtitle" Text="Панель управления Yetta" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Center"
                  Background="{DynamicResource SelectedBrush}" CornerRadius="10" Padding="12,8">
            <TextBlock x:Name="ThemeIndicator" Text="Windows 11" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="34,30,34,30">
        <ScrollViewer.Resources>
          <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel x:Name="ContentPanel"/>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="34,0">
          <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}">Иконки предоставлены сервисом <Hyperlink NavigateUri="https://icons8.ru/" RequestNavigate="OnFooterLink">Icons8</Hyperlink></TextBlock>
          <TextBlock Text="0.3.1-preview" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
        </Grid>
      </Border>
      <StackPanel x:Name="ToastHost" Grid.RowSpan="3" Panel.ZIndex="20" Width="324" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,12,22,56"/>
    </Grid>
    </Grid>
  </Grid>
</Window>
