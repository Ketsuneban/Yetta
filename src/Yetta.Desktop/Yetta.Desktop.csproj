<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yetta</AssemblyName>
    <RootNamespace>Yetta.Desktop</RootNamespace>
    <Version>0.3.5</Version>
    <ApplicationIcon Condition="Exists('Assets/yetta.ico')">Assets/yetta.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Yetta.Core/Yetta.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <Resource Include="Assets/Inter.ttf" />
    <Resource Include="Assets/26.png" />
    <Resource Include="Assets/27.png" />
    <Resource Include="Assets/31.png" />
    <Resource Include="Assets/35.png" />
    <Resource Include="Assets/yetta-icons-atlas.png" />
    <Resource Include="Assets/yetta-logo.png" />
    <Resource Include="Assets/dax-logo.png" />
    <EmbeddedResource Include="Assets/OFL-Inter.txt" />
  </ItemGroup>
</Project>
