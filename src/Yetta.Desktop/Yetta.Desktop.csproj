<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yetta</AssemblyName>
    <RootNamespace>Yetta.Desktop</RootNamespace>
    <Version>0.3.20</Version>
    <ApplicationIcon Condition="Exists('Assets/yetta.ico')">Assets/yetta.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.2" />
    <ProjectReference Include="../Yetta.Core/Yetta.Core.csproj" />
    <Resource Include="Assets/Inter.ttf" />
    <Resource Include="Assets/26.png" />
    <Resource Include="Assets/27.png" />
    <Resource Include="Assets/31.png" />
    <Resource Include="Assets/35.png" />
    <Resource Include="Assets/yetta-logo.png" />
    <Resource Include="Assets/external-link.png" />
    <Resource Include="Assets/dax-logo.png" />
    <Resource Include="Assets/warning-skull.png" />
    <Resource Include="Assets/yetta-icons-atlas.png" />
    <Resource Include="Assets/icons/*.png" />
    <EmbeddedResource Include="Assets/OFL-Inter.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../local.json" Link="local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
