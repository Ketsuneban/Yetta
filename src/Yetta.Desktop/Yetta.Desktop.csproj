<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yetta</AssemblyName>
    <RootNamespace>Yetta.Desktop</RootNamespace>
    <Company>Tallow</Company>
    <Authors>Tallow</Authors>
    <Version>0.6.2</Version>
    <ApplicationIcon Condition="Exists('Assets/yetta.ico')">Assets/yetta.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Microsoft.Security.Extensions" Version="1.4.0" />
    <ProjectReference Include="../Yetta.Core/Yetta.Core.csproj" />
    <Resource Include="Assets/26.png" />
    <Resource Include="Assets/27.png" />
    <Resource Include="Assets/31.png" />
    <Resource Include="Assets/35.png" />
    <Resource Include="Assets/yetta-logo.png" />
    <Resource Include="Assets/external-link.png" />
    <Resource Include="Assets/dax-logo.png" />
    <Resource Include="Assets/warning-skull.png" />
    <Resource Include="Assets/yetta-icons-atlas.png" />
    <Resource Include="Assets/icons/*.png" />
    <Resource Include="Assets/Causes/*.png" />
    <Resource Include="Assets/Profiles/*.png" />
    <Resource Include="Assets/States/*.png" />
    <Resource Include="Assets/Defender/*.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../local.json" Link="local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleDax)' == 'true'">
    <AssemblyMetadata Include="DaxInstallerSha256" Value="$(DaxInstallerSha256)" />
    <Content Include="../../artifacts/python/**/*" Link="Python/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
    <Content Include="../../artifacts/tray/Yetta.DAX.exe" Link="Yetta.DAX.exe" CopyToPublishDirectory="Always" />
    <Content Include="../../artifacts/setup/YettaDaxAdministratorSetup.exe" Link="YettaDaxAdministratorSetup.exe" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
